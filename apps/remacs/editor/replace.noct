//
// query-replace: the interactive y/n/!/q/. loop over matches.
//
// isRe selects regexp matching (Emacs syntax, via the re-search
// layer) or literal search. Replacement expansion follows
// replace-regexp rules in the regexp case.
//

func queryReplaceLoop(ed, from, to, isRe) {
    var count = 0;
    var auto = 0;
    while (true) {
        var ms = 0;
        var me = 0;
        if (isRe == 1) {
            if (Editor.reSearchForward(from) == 0) {
                break;
            }
            ms = Editor.matchBeginning(0);
            me = Editor.matchEnd(0);
        } else {
            if (Editor.searchForward(from) == 0) {
                break;
            }
            me = Editor.point();
            ms = me - String.charCount(from);
        }

        var doIt = 1;
        var stop = 0;
        if (auto == 0) {
            Editor.gotoChar(me);
            ed.echoMessage = "Query replacing " + from + " with " + to + ": (y/n/!/q/.)";
            redisplay(ed);
            var answered = 0;
            while (answered == 0) {
                var k = Term.readKey(30000);
                if (k < 0) {
                    continue;
                }
                answered = 1;
                if (k == 0x79 || k == 0x20) {          // y / SPC
                    doIt = 1;
                } else if (k == 0x6E || k == 0x7F) {   // n / DEL
                    doIt = 0;
                } else if (k == 0x21) {                // !
                    doIt = 1;
                    auto = 1;
                } else if (k == 0x2E) {                // .
                    doIt = 1;
                    stop = 1;
                } else {                               // q / RET / C-g / other
                    doIt = 0;
                    stop = 1;
                }
            }
        }

        if (doIt == 1) {
            var rep = to;
            if (isRe == 1) {
                var whole = Editor.bufferSubstring(ms, me);
                rep = expandReplacement(to, whole, matchGroupTexts());
            }
            Editor.deleteRegion(ms, me);
            Editor.gotoChar(ms);
            Editor.insert(rep);
            count = count + 1;
            if (me == ms && !Editor.eobp()) {
                Editor.forwardChar(1);
            }
        } else {
            Editor.gotoChar(me);
        }
        if (stop == 1) {
            break;
        }
    }
    ed.echoMessage = "Replaced " + count + " occurrences";
    return 0;
}
