//
// Incremental search, tty flavor.
//
// C-s / C-r enter isearch; printable characters extend the search
// string and the match follows live. C-s / C-r repeat in either
// direction (reusing the last string when the current one is empty),
// DEL undoes the last step (restoring the previous match position),
// RET exits leaving point and saves the mark where the search began,
// C-g aborts back to the starting point. Any other key exits.
//
// A state stack makes DEL a true rewind, like Emacs: each successful
// or failing step pushes {s, point, success, wrapped}.
//

func isearchMode(ed, dir) {
    var origin = Editor.point();
    var s = "";
    var success = 1;
    var wrapped = 0;
    var stack = [];
    // skk-isearch: when SKK is on, letters compose into kana that
    // extend the search string. iskk holds the in-progress romaji.
    var iskk = { pending: "", out: "", mode: "hira" };
    // The last search string survives across isearch invocations.
    if (!Dict.hasKey(ed, "lastSearch")) {
        ed.lastSearch = "";
    }

    while (true) {
        ed.iskkPending = iskk.pending;
        isearchEcho(ed, s, dir, success, wrapped);
        redisplay(ed);
        var k = Term.readKey(30000);
        if (k < 0) {
            continue;
        }

        if (k == (Term.CTRL | 0x67)) {                    // C-g: abort
            Editor.gotoChar(origin);
            ed.echoMessage = "Quit";
            return 0;
        }
        if (k == 0x0D) {                                  // RET: exit
            if (s != "") {
                ed.lastSearch = s;
            }
            Editor.pushMark(origin);
            ed.echoMessage = "Mark saved where search started";
            return 0;
        }
        if (k == 0x7F) {                                  // DEL: rewind
            var n = Array.size(stack);
            if (n == 0) {
                continue;
            }
            var top = stack[n - 1];
            Array.pop(stack);
            s = top.s;
            success = top.success;
            wrapped = top.wrapped;
            Editor.gotoChar(top.point);
            continue;
        }
        if (k == (Term.CTRL | 0x73) || k == (Term.CTRL | 0x72)) {
            // C-s / C-r: repeat (or turn around).
            var newDir = 1;
            if (k == (Term.CTRL | 0x72)) {
                newDir = 0 - 1;
            }
            if (s == "") {
                if (ed.lastSearch == "") {
                    continue;
                }
                s = ed.lastSearch;
            }
            Array.push(stack, isearchFrame(s, success, wrapped));
            if (dir == newDir && success == 0) {
                // Failing repeat wraps around.
                if (dir > 0) {
                    Editor.gotoChar(Editor.pointMin());
                } else {
                    Editor.gotoChar(Editor.pointMax());
                }
                wrapped = 1;
            }
            dir = newDir;
            success = isearchStep(s, dir, 0);
            continue;
        }
        // skk-isearch: compose letters into kana.
        if (skkActive() == 1 && Buf.skkMode != "ascii" &&
            ((k >= 0x61 && k <= 0x7A) || (k >= 0x41 && k <= 0x5A))) {
            iskk.mode = Buf.skkMode;
            iskk.out = "";
            skkComposeChar(iskk, String.toLowerCase(String.chr(k)));
            if (iskk.out != "") {
                Array.push(stack, isearchFrame(s, success, wrapped));
                s = s + iskk.out;
                success = isearchStep(s, dir, 1);
            }
            continue;
        }
        if (k >= 0x20 && k < 0x110000) {                  // extend
            Array.push(stack, isearchFrame(s, success, wrapped));
            iskk.pending = "";
            s = s + Editor.charToString(k);
            // Retry from the start of the current match so the match
            // can extend in place.
            success = isearchStep(s, dir, 1);
            continue;
        }

        // Anything else exits isearch, leaving point where it is.
        if (s != "") {
            ed.lastSearch = s;
        }
        ed.echoMessage = "";
        return 0;
    }
}

func isearchFrame(s, success, wrapped) {
    return { s: s, point: Editor.point(), success: success, wrapped: wrapped };
}

// One search attempt. When extending, the window is adjusted so the
// occurrence currently under point can keep matching in place:
// forward search backs up to the current match start, backward search
// bounds the haystack just past the current match start.
func isearchStep(s, dir, extending) {
    var from = Editor.point();
    if (dir > 0) {
        if (extending == 1) {
            var target = from - (String.charCount(s) - 1);
            if (target < Editor.pointMin()) {
                target = Editor.pointMin();
            }
            Editor.gotoChar(target);
        }
        if (Editor.searchForward(s)) {
            return 1;
        }
        Editor.gotoChar(from);
        return 0;
    }
    if (extending == 1) {
        var bound = from + String.charCount(s);
        if (bound > Editor.pointMax()) {
            bound = Editor.pointMax();
        }
        Editor.gotoChar(bound);
    }
    if (Editor.searchBackward(s)) {
        return 1;
    }
    Editor.gotoChar(from);
    return 0;
}

func isearchEcho(ed, s, dir, success, wrapped) {
    var msg = "I-search";
    if (dir < 0) {
        msg = msg + " backward";
    }
    msg = msg + ": " + s;
    if (Dict.hasKey(ed, "iskkPending") && ed.iskkPending != "") {
        msg = msg + ed.iskkPending;
    }
    if (success == 0) {
        msg = "Failing " + msg;
    } else if (wrapped == 1) {
        msg = "Wrapped " + msg;
    }
    ed.echoMessage = msg;
    // Cursor in the "minibuffer" (end of the search string); the
    // buffer point keeps a reverse-video block so the match position
    // stays visible.
    ed.echoCursor = stringWidth(msg);
    ed.echoHl = 1;
    return 0;
}
