func oracleTest() {
    Editor.insert("line one\nline two\nline three");
    Editor.gotoChar(1);
    oracleEmit(Editor.forwardLine(1));
    oracleEmit(Editor.point());
    oracleEmit(Editor.forwardLine(1));
    oracleEmit(Editor.point());
    oracleEmit(Editor.forwardLine(5));
    oracleEmit(Editor.point());
    oracleEmit(Editor.forwardLine(-1));
    oracleEmit(Editor.point());
    oracleEmit(Editor.forwardLine(-10));
    oracleEmit(Editor.point());
    oracleEmit(Editor.bolp());
    oracleEmit(Editor.eolp());
    Editor.gotoChar(9);
    oracleEmit(Editor.bolp());
    oracleEmit(Editor.eolp());
    Editor.gotoChar(12);
    oracleEmit(Editor.lineBeginningPosition());
    oracleEmit(Editor.lineEndPosition());
    Editor.backwardChar(3);
    oracleEmit(Editor.point());
    oracleTestEdges();
}

func oracleTestEdges() {
    // Already at end-of-buffer.
    Editor.gotoChar(Editor.pointMax());
    oracleEmit(Editor.forwardLine(3));
    oracleEmit(Editor.point());
    // A buffer that ends in a newline.
    Editor.deleteRegion(Editor.pointMin(), Editor.pointMax());
    Editor.insert("a\nb\n");
    Editor.gotoChar(1);
    oracleEmit(Editor.forwardLine(2));
    oracleEmit(Editor.point());
    oracleEmit(Editor.forwardLine(2));
    oracleEmit(Editor.point());
    Editor.gotoChar(3);
    oracleEmit(Editor.forwardLine(-5));
    oracleEmit(Editor.point());
    // Exactly consumed.
    Editor.gotoChar(1);
    oracleEmit(Editor.forwardLine(1));
    oracleEmit(Editor.point());
}
