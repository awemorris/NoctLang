# remacs — Re-implemented Editing Macros, on the Noct VM.
#
# Build the single-file bytecode bundle and install it so that an
# unmodified `noct` runs the editor:
#
#     make            # build build-nb/REMACS.NB
#     sudo make install
#     remacs [file]
#
# The launcher /usr/bin/remacs is a shell script that runs
# `noct <prefix>/share/remacs/noct/REMACS.NB`. The resource prefix is
# chosen per operating system below.

# --- tools -----------------------------------------------------------

PYTHON ?= python3

# Find a noct compiler: an explicit NOCT, else the in-tree build, else
# one on PATH.
NOCT ?= $(firstword $(wildcard build-debug/noctlang/noct ../../build/noct) noct)

# --- install layout (OS-dependent) -----------------------------------

PREFIX      ?= /usr
BINDIR      ?= $(PREFIX)/bin

UNAME_S := $(shell uname -s)

# Pick the share directory by distribution family. Debian/Ubuntu and
# RedHat/Fedora both use /usr/share; the split exists so packagers can
# override per family. FreeBSD and other BSDs conventionally install
# third-party data under /usr/local/share.
ifeq ($(UNAME_S),Linux)
  ifneq ($(wildcard /etc/debian_version),)
    OS_FAMILY := debian
    SHAREDIR  ?= $(PREFIX)/share
  else ifneq ($(wildcard /etc/redhat-release),)
    OS_FAMILY := redhat
    SHAREDIR  ?= $(PREFIX)/share
  else
    OS_FAMILY := linux
    SHAREDIR  ?= $(PREFIX)/share
  endif
else ifeq ($(UNAME_S),FreeBSD)
  OS_FAMILY := freebsd
  PREFIX    := /usr/local
  BINDIR    := $(PREFIX)/bin
  SHAREDIR  ?= $(PREFIX)/share
else ifeq ($(UNAME_S),Darwin)
  OS_FAMILY := macos
  SHAREDIR  ?= $(PREFIX)/share
else
  OS_FAMILY := unknown
  SHAREDIR  ?= $(PREFIX)/share
endif

RESDIR  := $(SHAREDIR)/remacs
NOCTDIR := $(RESDIR)/noct

# --- build -----------------------------------------------------------

GEN     := build-nb/generated
BUNDLE  := build-nb/REMACS.NB

.PHONY: all
all: $(BUNDLE)

$(BUNDLE): $(wildcard editor/*.noct) src/napi.def tools/gen-napi.py tools/build-nb.sh
	@echo "Detected OS family: $(OS_FAMILY)  (share -> $(RESDIR))"
	@mkdir -p $(GEN)
	$(PYTHON) tools/gen-napi.py src/napi.def $(GEN)
	sh tools/build-nb.sh "$(NOCT)" "$(GEN)" build-nb

# --- install / uninstall ---------------------------------------------

.PHONY: install
install: $(BUNDLE)
	@echo "Installing remacs for $(OS_FAMILY)"
	install -d "$(DESTDIR)$(NOCTDIR)"
	install -m 0644 "$(BUNDLE)" "$(DESTDIR)$(NOCTDIR)/REMACS.NB"
	install -d "$(DESTDIR)$(BINDIR)"
	@printf '#!/bin/sh\n# remacs launcher (generated by make install)\nexec noct "%s/REMACS.NB" "$$@"\n' "$(NOCTDIR)" \
	  > "$(DESTDIR)$(BINDIR)/remacs"
	chmod 0755 "$(DESTDIR)$(BINDIR)/remacs"
	@echo "Installed:"
	@echo "  $(DESTDIR)$(BINDIR)/remacs"
	@echo "  $(DESTDIR)$(NOCTDIR)/REMACS.NB"

.PHONY: uninstall
uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/remacs"
	rm -rf "$(DESTDIR)$(RESDIR)"

# --- misc ------------------------------------------------------------

.PHONY: test
test: $(BUNDLE)
	cd tests && sh run-all.sh

.PHONY: clean
clean:
	rm -rf build-nb

.PHONY: showconfig
showconfig:
	@echo "OS_FAMILY = $(OS_FAMILY)"
	@echo "PREFIX    = $(PREFIX)"
	@echo "BINDIR    = $(BINDIR)"
	@echo "SHAREDIR  = $(SHAREDIR)"
	@echo "RESDIR    = $(RESDIR)"
	@echo "NOCTDIR   = $(NOCTDIR)"
	@echo "NOCT      = $(NOCT)"
