# remacs — Re-implemented Editing Macros, on the Noct VM.
#
# Build the single-file bytecode bundle and install it so that an
# unmodified `noct` runs the editor:
#
#     make            # build build-nap/remacs.nap
#     sudo make install
#     remacs [file]
#
# The launcher /usr/bin/remacs is a shell script that runs
# `noct <prefix>/share/remacs/noct/remacs.nap`. The resource prefix is
# chosen per operating system below.

# --- tools -----------------------------------------------------------

PYTHON ?= python3

# Find a noct compiler: an explicit NOCT, else the in-tree build, else
# one on PATH.
NOCT ?= $(firstword $(wildcard build-debug/noctlang/noct ../../build/noct) noct)

# --- install layout (OS-dependent) -----------------------------------

PREFIX      ?= /usr
BINDIR      ?= $(PREFIX)/bin

UNAME_S := $(shell uname -s)

# Pick the share directory by distribution family. Debian/Ubuntu and
# RedHat/Fedora both use /usr/share; the split exists so packagers can
# override per family. FreeBSD and other BSDs conventionally install
# third-party data under /usr/local/share.
ifeq ($(UNAME_S),Linux)
  ifneq ($(wildcard /etc/debian_version),)
    OS_FAMILY := debian
    SHAREDIR  ?= $(PREFIX)/share
  else ifneq ($(wildcard /etc/redhat-release),)
    OS_FAMILY := redhat
    SHAREDIR  ?= $(PREFIX)/share
  else
    OS_FAMILY := linux
    SHAREDIR  ?= $(PREFIX)/share
  endif
else ifeq ($(UNAME_S),FreeBSD)
  OS_FAMILY := freebsd
  PREFIX    := /usr/local
  BINDIR    := $(PREFIX)/bin
  SHAREDIR  ?= $(PREFIX)/share
else ifeq ($(UNAME_S),Darwin)
  OS_FAMILY := macos
  SHAREDIR  ?= $(PREFIX)/share
else
  OS_FAMILY := unknown
  SHAREDIR  ?= $(PREFIX)/share
endif

RESDIR  := $(SHAREDIR)/remacs
NOCTDIR := $(RESDIR)/noct
DICTDIR := $(RESDIR)/dict

# --- build -----------------------------------------------------------

GEN     := build-nap/generated
BUNDLE  := build-nap/remacs.nap
SKKDICT := dict/SKK-JISYO.remacs
SKKDICTX := dict/SKK-JISYO.X

.PHONY: all
all: $(BUNDLE) $(SKKDICT) $(SKKDICTX)

$(BUNDLE): $(wildcard editor/*.noct) src/napi.def tools/gen-napi.py tools/build-nap.sh
	@echo "Detected OS family: $(OS_FAMILY)  (share -> $(RESDIR))"
	@mkdir -p $(GEN)
	$(PYTHON) tools/gen-napi.py src/napi.def $(GEN)
	sh tools/build-nap.sh "$(NOCT)" "$(GEN)" build-nap

# The bundled clean-room SKK dictionaries are regenerated from the authored /
# collected word lists in tools/skkdict/ (python only; the MeCab / Sudachi
# cross-check in tools/skkdict/collect.py is a separate dev step).
#   SKK-JISYO.remacs : compact default   (src/*.tsv)
#   SKK-JISYO.X      : full corpus vers.  (src/*.tsv + srcx/*.tsv)
$(SKKDICT): tools/skkdict/expand.py $(wildcard tools/skkdict/src/*.tsv)
	$(PYTHON) tools/skkdict/expand.py "$@" "tools/skkdict/src/*.tsv"

$(SKKDICTX): tools/skkdict/expand.py $(wildcard tools/skkdict/src/*.tsv) $(wildcard tools/skkdict/srcx/*.tsv)
	$(PYTHON) tools/skkdict/expand.py "$@" "tools/skkdict/src/*.tsv" "tools/skkdict/srcx/*.tsv"

# --- install / uninstall ---------------------------------------------

.PHONY: install
install: $(BUNDLE) $(SKKDICT) $(SKKDICTX)
	@echo "Installing remacs for $(OS_FAMILY)"
	install -d "$(DESTDIR)$(NOCTDIR)"
	install -m 0644 "$(BUNDLE)" "$(DESTDIR)$(NOCTDIR)/remacs.nap"
	install -d "$(DESTDIR)$(DICTDIR)"
	install -m 0644 "$(SKKDICT)"  "$(DESTDIR)$(DICTDIR)/SKK-JISYO.remacs"
	install -m 0644 "$(SKKDICTX)" "$(DESTDIR)$(DICTDIR)/SKK-JISYO.X"
	install -d "$(DESTDIR)$(BINDIR)"
	@printf '#!/bin/sh\n# remacs launcher (generated by make install)\n# SKK-JISYO.remacs is the compact default; set REMACS_SKK_DICT to\n# %s/SKK-JISYO.X (or your own SKK-JISYO.L) for a fuller dictionary.\nREMACS_SKK_DICT="$${REMACS_SKK_DICT:-%s/SKK-JISYO.remacs}"\nexport REMACS_SKK_DICT\nexec noct "%s/remacs.nap" "$$@"\n' "$(DICTDIR)" "$(DICTDIR)" "$(NOCTDIR)" \
	  > "$(DESTDIR)$(BINDIR)/remacs"
	chmod 0755 "$(DESTDIR)$(BINDIR)/remacs"
	@echo "Installed:"
	@echo "  $(DESTDIR)$(BINDIR)/remacs"
	@echo "  $(DESTDIR)$(NOCTDIR)/remacs.nap"
	@echo "  $(DESTDIR)$(DICTDIR)/SKK-JISYO.remacs  (default)"
	@echo "  $(DESTDIR)$(DICTDIR)/SKK-JISYO.X       (full; set REMACS_SKK_DICT to use)"

.PHONY: uninstall
uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/remacs"
	rm -rf "$(DESTDIR)$(RESDIR)"

# --- misc ------------------------------------------------------------

.PHONY: test
test: $(BUNDLE)
	cd tests && sh run-all.sh

.PHONY: clean
clean:
	rm -rf build-nap

.PHONY: showconfig
showconfig:
	@echo "OS_FAMILY = $(OS_FAMILY)"
	@echo "PREFIX    = $(PREFIX)"
	@echo "BINDIR    = $(BINDIR)"
	@echo "SHAREDIR  = $(SHAREDIR)"
	@echo "RESDIR    = $(RESDIR)"
	@echo "NOCTDIR   = $(NOCTDIR)"
	@echo "NOCT      = $(NOCT)"
