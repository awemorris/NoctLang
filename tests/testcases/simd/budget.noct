// Deliberately over the 8-vreg budget (many temps): must compile and
// run identically at both levels, silently scalar.
func main() {
    var n = 12;
    var p = Packed.uint32(n);
    var q = Packed.uint32(n);
    for (i in 0..n) {
        p[i] = i + 1;
    }
    for (i in 0..n) {
        var t0 = p[i] + 1;
        var t1 = t0 * 2;
        var t2 = t1 ^ 5;
        var t3 = t2 + t0;
        var t4 = t3 * 3;
        var t5 = t4 & 4095;
        var t6 = t5 + t1;
        var t7 = t6 ^ t2;
        var t8 = t7 + t3;
        q[i] = t8 & 65535;
    }
    var sum = 0;
    for (i in 0..n) {
        sum = sum + q[i];
    }
    print(sum);
}
