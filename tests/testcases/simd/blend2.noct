func main() {
    let image1 = Packed.uint32(1280 * 720);
    let image2 = Packed.uint32(1280 * 720);
    image1[0] = (255 << 24) | (40 << 16) | (80 << 8) | 120;
    image2[0] = (128 << 24) | (200 << 16) | (100 << 8) | 50;
    blend(image1, image2, 128);
    print(image1[0]);
    print(image1[1]);
    print(image1[1280 * 720 - 1]);
}

func blend(dst: rpackeduint32, src: rpackeduint32, alpha: int) {
    // Effective source opacity is src_a * alpha / (255 * 255).
    let alpha_float = alpha / 65025.0;

    for (y in 0..720) {
        for (x in 0..1280) {
            let dst_pix = dst[y * 1280 + x];
            let src_pix = src[y * 1280 + x];

            let dst_a = (dst_pix >> 24) & 0xff;
            let dst_r = (dst_pix >> 16) & 0xff;
            let dst_g = (dst_pix >> 8) & 0xff;
            let dst_b = dst_pix & 0xff;

            let src_a = (src_pix >> 24) & 0xff;
            let src_r = (src_pix >> 16) & 0xff;
            let src_g = (src_pix >> 8) & 0xff;
            let src_b = src_pix & 0xff;

            let pix_a = Float.from(src_a) * alpha_float;
            let pix_inv_a = 1.0 - pix_a;

            let pix_r = Float.from(src_r) * pix_a + Float.from(dst_r) * pix_inv_a;
            let pix_g = Float.from(src_g) * pix_a + Float.from(dst_g) * pix_inv_a;
            let pix_b = Float.from(src_b) * pix_a + Float.from(dst_b) * pix_inv_a;

            let pix = (255 << 24) |
                (Int.from(pix_r) << 16) |
                (Int.from(pix_g) << 8) |
                (Int.from(pix_b));

            dst[y * 1280 + x] = pix;
        }
    }
}
