// Integer division edges.  x / 0 is still a runtime error (Part 0
// changed only float/double-performed divisions), and a variable or
// {0,-1}-literal divisor stays on the generic helper.
// (INT_MIN / -1 is a known pre-existing process abort in the generic
// helper and is deliberately not exercised here.)

func f(a: int, b: int) {
    print(a / b);        // variable divisor: generic
    print(a % b);        // variable divisor: generic
    print(a / 0);        // 0-literal divisor: stays generic; runtime error
}

func main() {
    f(100, 7);
    return 0;
}
